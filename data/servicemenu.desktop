[Desktop Entry]
Type=Service
MimeType=application/zip;application/x-zip-compressed;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/x-tar;application/x-compressed-tar;application/x-bzip-compressed-tar;application/x-bzip2-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-lzma-compressed-tar;application/gzip;application/x-bzip;application/x-bzip2;application/x-xz;application/zstd;application/x-lzma;application/x-cd-image;application/vnd.ms-cab-compressed;
Actions=extrairJuntos;
X-KDE-Priority=TopLevel

[Desktop Action extrairJuntos]
Name=Extrair todos juntos...
Icon=archive-extract
Exec=@EXEC@ %F
